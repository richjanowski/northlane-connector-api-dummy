{
  "$schema": "https://api.northlane.example/schemas/features.json",
  "api_version": "2.4.0",
  "last_updated": "2026-06-15",
  "plans": {
    "starter": {
      "label": "Starter",
      "max_enterprises": 1,
      "portfolio_access_tokens": false,
      "rate_limit_per_minute": 600,
      "features": [
        "reservations.basic",
        "resources.basic",
        "webhooks.basic"
      ]
    },
    "growth": {
      "label": "Growth",
      "max_enterprises": 5,
      "portfolio_access_tokens": true,
      "rate_limit_per_minute": 1200,
      "features": [
        "reservations.basic",
        "resources.basic",
        "resources.bulk_update",
        "webhooks.basic",
        "webhooks.retries",
        "reports.basic"
      ]
    },
    "enterprise": {
      "label": "Enterprise",
      "max_enterprises": null,
      "portfolio_access_tokens": true,
      "rate_limit_per_minute": 2400,
      "features": [
        "reservations.basic",
        "reservations.bulk_create",
        "resources.basic",
        "resources.bulk_update",
        "webhooks.basic",
        "webhooks.retries",
        "webhooks.custom_events",
        "reports.basic",
        "reports.advanced",
        "sso.saml"
      ]
    }
  },
  "feature_notes": {
    "resources.bulk_update": "Added in API version 2.4.0 via PATCH /v1/resources/bulk.",
    "reports.basic": "Requires the reports:read scope. See authentication.md.",
    "sso.saml": "Enterprise plan only; configured separately in the account dashboard, not via the Connector API."
  }
}
